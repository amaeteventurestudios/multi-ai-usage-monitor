<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amaeteventurestudios.multi-ai-usage-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Replace with the ABSOLUTE path to the built binary, e.g.
             /Users/example/multi-ai-usage-monitor/Multi AI Usage Monitor.app/Contents/MacOS/MultiAIUsageMonitor -->
        <string>__APP_BINARY_PATH__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardErrorPath</key>
    <string>/tmp/multi-ai-usage-monitor.err.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/multi-ai-usage-monitor.out.log</string>
</dict>
</plist>
